# コピーして .env.local を作る：cp .env.example .env.local

# サイトのURL（canonical・sitemap用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase の Postgres（ローカル：supabase start 後のDB URL）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 管理画面 /admin の Basic 認証（未設定なら管理画面は開けない）
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
