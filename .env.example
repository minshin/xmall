# コピーして .env.local を作る：cp .env.example .env.local

# サイトのURL（canonical・sitemap用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase の Postgres（ローカル：supabase start 後のDB URL）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres


# Supabase（Auth・Storage）。ローカルの値は `npm run db:status` の PUBLISHABLE_KEY / SECRET_KEY
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用（Storage へのアップロードに使う）。クライアントに渡さないこと
SUPABASE_SERVICE_ROLE_KEY=

# Google ログイン（任意）。supabase/config.toml の [auth.external.google] を参照
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
